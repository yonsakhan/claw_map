# 复制本文件为 .env，填入真实值，.env 已被 .gitignore 忽略

# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claw_map
POSTGRES_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@localhost:5432/claw_map

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=claw_map
MONGO_RAW_COLLECTION=raw_profiles
MONGO_TASK_COLLECTION=crawl_tasks

# LLM（支持 OpenAI / Moonshot Kimi / 其他兼容 API）
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key
MODEL_NAME=moonshot-v1-8k

# 小红书爬虫
XHS_LOGIN_MODE=manual
XHS_COOKIE=
